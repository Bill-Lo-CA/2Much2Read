{
  "manifest_version": 3,
  "name": "2fun4distract",
  "version": "1.0",
  "description": "Reports the domain of each window's active tab to your own 2fun4distract service, and nothing else.",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["alarms", "idle", "tabs"],
  "host_permissions": ["http://__HOST__/*"],
  "background": { "service_worker": "background.js" }
}
