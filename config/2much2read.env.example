# 2much2read runtime settings
# Maximum messages across all enabled sources in one run.
GMAIL_MAX_MESSAGES_PER_RUN=50
GMAIL_LOOKBACK_DAYS=7
GMAIL_OAUTH_CALLBACK_PORT=8765
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ALLOW_REMOTE=false
OLLAMA_TRUST_ENV=false
OLLAMA_MODEL=llama3.2:3b
OLLAMA_REVIEW_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=10m
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# Set to cuda only when the GPU has room to spare alongside the reviewer model.
RERANKER_DEVICE=cpu
DISCORD_DELIVERY_MODE=webhook
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=2much2read
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL_ID=
DIGEST_LANGUAGE=zh-TW
DIGEST_TIMEZONE=America/Montreal
DIGEST_SCHEDULE_TIME=08:00
DIGEST_SCHEDULE_TIMEZONE=America/Montreal
DIGEST_MAX_ITEMS=5
DIGEST_TOP_ITEMS=5
DIGEST_SECONDARY_ITEMS=10
DIGEST_MERGE_JUDGEMENTS=60
DIGEST_DEEPEN_HEADLINES=true
DIGEST_REVIEW_CANDIDATE_LIMIT=20
DIGEST_RERANK_CANDIDATE_LIMIT=100
DIGEST_SECURITY_CANDIDATE_SLOTS=7
