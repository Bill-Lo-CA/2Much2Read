[Unit]
Description=2fun4distract Daily Summary
# A few tries an hour apart: long enough to ride out a Discord outage, and the next day's summary is
# the real fallback after that.
StartLimitIntervalSec=1d
StartLimitBurst=6

[Service]
Type=oneshot
EnvironmentFile=%h/.config/2much2read-runtime/.2fun4distract.env
ExecStart=__EXECUTABLE__ summary
Restart=on-failure
RestartSec=1h
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/2much2read-runtime/2fun4distract
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
PrivateDevices=true
