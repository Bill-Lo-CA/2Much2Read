[Unit]
Description=2much2read Gmail Digest

[Service]
Type=oneshot
EnvironmentFile=%h/.config/2much2read-runtime/.2much2read.env
Environment=HF_HOME=%h/.local/share/2much2read-runtime/2much2read/huggingface
ExecStart=__EXECUTABLE__ run
# Room for the run after an email's extraction timed out, which gives that email two tries: up to
# four OLLAMA_TIMEOUT_SECONDS waits, story scan and extraction each time, and a probe of up to a
# minute, on top of the usual run of up to twenty minutes. A run killed here records nothing, so
# every run after would be killed at the same email.
TimeoutStartSec=60min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/2much2read-runtime/2much2read %h/.local/share/2much2read-runtime/2much2read
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Not ~@resources, unlike the other units: PyTorch calls sched_setaffinity when the reranker loads,
# and a denied call kills the process with SIGSYS.
SystemCallFilter=~@privileged
