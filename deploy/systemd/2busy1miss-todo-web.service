[Unit]
Description=2busy1miss To-do Page (tailnet only)
# Tailscale can come up after this does, so it keeps trying however long that takes.
StartLimitIntervalSec=0

[Service]
Type=exec
# No EnvironmentFile: that file holds the Discord webhook, and nothing here sends anything. The one
# setting this needs from it arrives below, and ProtectHome hides the file itself.
Environment=REMINDER_TIMEZONE=__TIMEZONE__
ExecStart=__EXECUTABLE__ todo serve --host __HOST__ --port __PORT__
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
ProtectSystem=strict
# Home is empty but for the code, the reminders file for its timezone, and the database. The Gmail
# and Calendar tokens and every environment file are not there to read.
ProtectHome=tmpfs
BindReadOnlyPaths=__REPO_DIR__/.venv __REPO_DIR__/src %h/.config/2much2read-runtime/reminders.yaml
BindPaths=%h/.local/share/2much2read-runtime/2busy1miss
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
PrivateDevices=true

[Install]
WantedBy=default.target
